// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © TradeGuard v7.0 — Chart Overlay
// Script 1 of 3: Clean chart overlay with MAs, SuperTrend, entry/stop levels, signal markers, alerts
// ALL tables/dashboards are in the separate TradeGuard_Dashboard.pine script

//@version=6
indicator("TradeGuard v7.0", overlay=true, max_labels_count=100, max_lines_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Account ---
grp_acct = "Account Settings"
i_account_nav    = input.float(450000, "Account NAV ($)",          group=grp_acct, minval=1000, tooltip="Total account net asset value")
i_risk_trend_pct = input.float(1.0,    "Risk per TREND trade (%)", group=grp_acct, minval=0.1, maxval=5.0, step=0.1)
i_risk_cap_pct   = input.float(0.5,    "Risk per CAP trade (%)",   group=grp_acct, minval=0.1, maxval=2.0, step=0.1)
i_max_pos_pct    = input.float(20.0,   "Max position (% NAV)",     group=grp_acct, minval=1.0, maxval=50.0, step=0.5, tooltip="Hard cap on full position size as % of NAV")

// --- Entry ---
grp_entry = "Entry Settings"
i_entry_price  = input.float(0,      "Custom Entry Price (0 = use close)", group=grp_entry, minval=0, tooltip="Set a specific entry price for trade plan calculations. Leave at 0 to use the current close price.")
i_sector_etf   = input.symbol("XLK", "Sector ETF for RS",                  group=grp_entry)
i_min_template = input.int(7,        "Min Template Score",                  group=grp_entry, minval=1, maxval=8)
i_min_score    = input.int(9,        "Min Go/No-Go Score",                  group=grp_entry, minval=1, maxval=12)
i_min_rr       = input.float(3.0,    "Min R:R Ratio",                      group=grp_entry, minval=1.0, maxval=10.0, step=0.5)

// --- Stop ---
grp_stop = "Stop Settings"
i_max_stop_pct   = input.float(8.0, "Max Stop Distance (%)",        group=grp_stop, minval=1.0, maxval=20.0, step=0.5)
i_atr_low_mult   = input.float(2.0, "ATR Low-Vol Multiplier",       group=grp_stop, minval=1.0, maxval=5.0, step=0.25)
i_atr_high_mult  = input.float(2.5, "ATR High-Vol Multiplier",      group=grp_stop, minval=1.0, maxval=5.0, step=0.25)
i_atr_vol_thresh = input.float(4.0, "ATR Volatility Threshold (%)", group=grp_stop, minval=1.0, maxval=10.0, step=0.5)

// --- Signal Toggles ---
grp_sig = "Signal Markers"
i_sig_pullback = input.bool(true,  "Show Pullback Signals",       group=grp_sig)
i_sig_vcp      = input.bool(true,  "Show VCP Breakout Signals",   group=grp_sig)
i_sig_vwap     = input.bool(false, "Show VWAP Retest Signals",    group=grp_sig, tooltip="Off by default — can be noisy")
i_sig_gap      = input.bool(true,  "Show Earnings Gap Signals",   group=grp_sig)
i_sig_cap      = input.bool(true,  "Show Capitulation Signals",   group=grp_sig)
i_sig_blocked  = input.bool(false, "Show Entry Blocked Markers",  group=grp_sig, tooltip="Off by default — shows X when anti-chase filter blocks entry")
i_sig_climax   = input.bool(true,  "Show Climax Warnings",        group=grp_sig)
i_sig_min_score = input.int(6,     "Min Score to Show Signals",   group=grp_sig, minval=0, maxval=12, tooltip="Only show signals when Go/No-Go score is at or above this level. Set to 0 to show all.")

// --- Display ---
grp_disp = "Chart Display"
i_show_ma         = input.bool(true,  "Show Moving Averages",      group=grp_disp)
i_show_supertrend = input.bool(true,  "Show SuperTrend Lines",     group=grp_disp)
i_show_ext_bands  = input.bool(false, "Show Extension Bands",      group=grp_disp)
i_show_levels     = input.bool(true,  "Show Entry/Stop/R Lines",   group=grp_disp, tooltip="Horizontal lines for entry, stop, and R-levels on the last bar")
i_show_bg_regime  = input.bool(false, "Tint Background by Regime", group=grp_disp, tooltip="Very subtle background color based on market regime")

// --- VWAP ---
grp_vwap = "Anchored VWAP"
i_vwap_mode = input.string("Manual", "VWAP Anchor Mode", options=["Off", "Manual", "Auto-Detect", "Both"], group=grp_vwap)
i_vwap_date = input.time(timestamp("2025-01-01"), "Manual Anchor Date", group=grp_vwap)

// ═══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Moving Averages ---
sma50  = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)
ema21  = ta.ema(close, 21)
sma5   = ta.sma(close, 5)

// --- SuperTrend ---
[st_line_d, st_dir_d] = ta.supertrend(3.0, 14)
st_bull_d = st_dir_d < 0

[st_line_w, st_dir_w] = request.security(syminfo.tickerid, "W", ta.supertrend(3.0, 10))
st_bull_w = st_dir_w < 0

// --- ADX / RSI / ATR / Volume ---
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
rsi2      = ta.rsi(close, 2)
atr_val   = ta.atr(14)
atr_pct   = atr_val / close * 100
vol_sma50 = ta.sma(volume, 50)
vol_ratio = volume / vol_sma50
vol_breakout  = vol_ratio >= 1.4
vol_declining = ta.sma(volume, 10) < vol_sma50 * 0.8
vwap_val      = ta.vwap

// ═══════════════════════════════════════════════════════════════════════════════
// REGIME (for signal gating + optional background)
// ═══════════════════════════════════════════════════════════════════════════════

spy_close  = request.security("SPY", "D", close)
spy_sma200 = request.security("SPY", "D", ta.sma(close, 200))
vix_close  = request.security("CBOE:VIX", "D", close)
vix3m_close = request.security("CBOE:VIX3M", "D", close)
breadth    = request.security("INDEX:S5TH", "D", close)
hy_oas     = request.security("FRED:BAMLH0A0HYM2", "D", close)

spy_above_200 = spy_close > spy_sma200
regime_green  = spy_above_200 and vix_close < 20 and breadth > 50 and (na(hy_oas) or hy_oas < 5)
regime_red    = vix_close > 30 or (not na(hy_oas) and hy_oas > 6) or breadth < 30
regime_yellow = not regime_green and not regime_red

// Regime change detection
var string prev_regime = "YELLOW"
regime_str = regime_green ? "GREEN" : regime_red ? "RED" : "YELLOW"
regime_changed_to_red   = regime_str == "RED" and prev_regime != "RED"
regime_changed_to_green = regime_str == "GREEN" and prev_regime != "GREEN"
prev_regime := regime_str

// ═══════════════════════════════════════════════════════════════════════════════
// TREND TEMPLATE + SECTOR RS + SCORING (internal — needed for signal gating)
// ═══════════════════════════════════════════════════════════════════════════════

low_52w  = ta.lowest(low, 252)
high_52w = ta.highest(high, 252)

spy_close_d  = spy_close  // reuse
stock_6m_ret = (close - close[126]) / close[126] * 100
spy_6m_ret   = (spy_close_d - spy_close_d[126]) / spy_close_d[126] * 100
rs_score     = math.max(0, math.min(99, math.round(50 + (stock_6m_ret - spy_6m_ret) * 1.65)))

t1 = close > sma150 and close > sma200
t2 = sma150 > sma200
t3 = sma200 > nz(sma200[100])
t4 = sma50 > sma150 and sma50 > sma200
t5 = close > sma50
t6 = close >= 1.25 * low_52w
t7 = close >= 0.75 * high_52w
t8 = rs_score >= 70
template_score = (t1?1:0)+(t2?1:0)+(t3?1:0)+(t4?1:0)+(t5?1:0)+(t6?1:0)+(t7?1:0)+(t8?1:0)

// Sector RS
sector_close    = request.security(i_sector_etf, "D", close)
sector_3m_ret   = (sector_close - sector_close[63]) / sector_close[63] * 100
spy_3m_ret      = (spy_close_d - spy_close_d[63]) / spy_close_d[63] * 100
sector_rs_score = math.max(0, math.min(100, math.round(50 + (sector_3m_ret - spy_3m_ret) * 5)))
sector_strong   = sector_rs_score > 75

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY SIGNAL DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

pullback_signal = low <= ema21 and close > ema21 and close > open and close > (high+low)/2 and template_score >= i_min_template

range_current = ta.highest(high, 10) - ta.lowest(low, 10)
range_prior   = ta.highest(high[10], 20) - ta.lowest(low[10], 20)
vcp_setup     = range_current < range_prior * 0.6 and vol_declining and template_score >= i_min_template
pivot_high    = ta.highest(high, 10)
vcp_breakout  = ta.crossover(close, pivot_high[1]) and vol_breakout

vwap_touch  = low <= vwap_val * 1.005 and low >= vwap_val * 0.995
vwap_signal = vwap_touch and close > vwap_val and close > open and template_score >= i_min_template

earnings_gap = open > close[1] * 1.03 and volume > vol_sma50 * 2.0

cap_entry = rsi2 < 5 and close > sma200 and vix_close > 30 and template_score >= 6 and close > open and close > (high+low)/2

// Anti-chase
extended_21ema = close > ema21 * 1.10
extended_50sma = close > sma50 * 1.15
consec_green   = close>open and close[1]>open[1] and close[2]>open[2] and close[3]>open[3] and close[4]>open[4]
past_pivot     = close > pivot_high[1] * 1.05
entry_blocked  = extended_21ema or extended_50sma or consec_green or past_pivot

// ═══════════════════════════════════════════════════════════════════════════════
// GO/NO-GO SCORECARD (internal)
// ═══════════════════════════════════════════════════════════════════════════════

entry_price = i_entry_price == 0 ? close : i_entry_price
stop_mult   = atr_pct <= i_atr_vol_thresh ? i_atr_low_mult : i_atr_high_mult
raw_stop    = entry_price - (stop_mult * atr_val)
max_stop    = entry_price * (1 - i_max_stop_pct / 100)
initial_stop = math.max(raw_stop, max_stop)
r_value     = entry_price - initial_stop
rr_ratio    = r_value > 0 ? (high_52w - entry_price) / r_value : 0

has_pattern = pullback_signal or vcp_setup or vwap_signal or earnings_gap
pts_regime    = regime_green ? 2 : regime_yellow ? 1 : 0
pts_trend     = (st_bull_d?1:0) + (st_bull_w?1:0)
pts_sector    = sector_strong ? 1 : 0
pts_setup     = (template_score >= 8 ? 1 : 0) + (has_pattern ? 1 : 0)
pts_catalyst  = earnings_gap ? 1 : 0
pts_rr        = rr_ratio >= 5 ? 2 : rr_ratio >= 3 ? 1 : 0
pts_extension = (not extended_21ema and not extended_50sma) ? 1 : 0
pts_portfolio = adx_val > 25 ? 1 : 0
total_score   = pts_regime + pts_trend + pts_sector + pts_setup + pts_catalyst + pts_rr + pts_extension + pts_portfolio

verdict_go = total_score >= i_min_score

// Climax
climax_warning = close / ta.lowest(close, 15) > 1.25 or (open > high[1] and volume > vol_sma50 * 2.5) or math.sum(close > open ? 1 : 0, 10) >= 8

// ═══════════════════════════════════════════════════════════════════════════════
// POSITION SIZING (with NAV cap fix)
// ═══════════════════════════════════════════════════════════════════════════════

risk_dollars     = i_account_nav * (i_risk_trend_pct / 100)
shares_probe_raw = r_value > 0 ? math.floor(risk_dollars / r_value) : 0
shares_target_raw = math.floor(shares_probe_raw / 0.5)

// Enforce max position % NAV
max_shares_nav = entry_price > 0 ? math.floor((i_account_nav * i_max_pos_pct / 100) / entry_price) : 0
shares_target  = math.min(shares_target_raw, max_shares_nav)

// Recalculate from capped target
shares_probe   = math.floor(shares_target * 0.5)
shares_confirm = math.floor(shares_target * 0.30)
shares_load    = shares_target - shares_probe - shares_confirm

confirm_price = entry_price * 1.025
load_price    = entry_price * 1.05

// R-stage levels
breakeven_trigger = entry_price + r_value
trail_start       = entry_price + (2 * r_value)
wide_trail_start  = entry_price + (3 * r_value)

// ═══════════════════════════════════════════════════════════════════════════════
// ANCHORED VWAP
// ═══════════════════════════════════════════════════════════════════════════════

use_manual = i_vwap_mode == "Manual" or i_vwap_mode == "Both"
use_auto   = i_vwap_mode == "Auto-Detect" or i_vwap_mode == "Both"

auto_breakout = ta.crossover(close, high_52w[1]) and vol_breakout
var int auto_anchor_time = na
if auto_breakout
    auto_anchor_time := time

var float avwap_pv_m = 0.0, var float avwap_vol_m = 0.0, var float avwap_manual = na
if use_manual and time >= i_vwap_date
    if time[1] < i_vwap_date or barstate.isfirst
        avwap_pv_m := 0.0
        avwap_vol_m := 0.0
    avwap_pv_m  += hlc3 * volume
    avwap_vol_m += volume
    avwap_manual := avwap_vol_m > 0 ? avwap_pv_m / avwap_vol_m : na

var float avwap_pv_a = 0.0, var float avwap_vol_a = 0.0, var float avwap_auto = na
if use_auto and not na(auto_anchor_time) and time >= auto_anchor_time
    if time[1] < auto_anchor_time
        avwap_pv_a := 0.0
        avwap_vol_a := 0.0
    avwap_pv_a  += hlc3 * volume
    avwap_vol_a += volume
    avwap_auto  := avwap_vol_a > 0 ? avwap_pv_a / avwap_vol_a : na

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL OVERLAYS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Moving Averages ---
plot(i_show_ma ? sma50  : na, "SMA 50",  color=color.new(#2196F3, 20), linewidth=1)
plot(i_show_ma ? sma150 : na, "SMA 150", color=color.new(#FF9800, 20), linewidth=1)
plot(i_show_ma ? sma200 : na, "SMA 200", color=color.new(#F44336, 20), linewidth=1)
plot(i_show_ma ? ema21  : na, "EMA 21",  color=color.new(#4CAF50, 10), linewidth=1)

// --- SuperTrend ---
plot(i_show_supertrend ? st_line_d : na, "ST Daily",  color=st_bull_d ? color.new(#00E676,0) : color.new(#FF5252,0), linewidth=2, style=plot.style_linebr)
plot(i_show_supertrend ? st_line_w : na, "ST Weekly", color=st_bull_w ? color.new(#00E676,50) : color.new(#FF5252,50), linewidth=3, style=plot.style_linebr)

// --- Extension Bands ---
plot(i_show_ext_bands ? ema21 * 1.10 : na, "+10% EMA21", color=color.new(#FF9800, 70), linewidth=1)
plot(i_show_ext_bands ? sma50 * 1.15 : na, "+15% SMA50", color=color.new(#FF1744, 70), linewidth=1)

// --- Anchored VWAP ---
plot(use_manual ? avwap_manual : na, "AVWAP Manual", color=color.new(#AB47BC, 0), linewidth=2)
plot(use_auto ? avwap_auto : na, "AVWAP Auto", color=color.new(#7C4DFF, 0), linewidth=2)

// --- Entry/Stop/R-Level Lines (last bar only) ---
show_lines = i_show_levels and barstate.islast
if show_lines
    line.new(bar_index - 20, entry_price, bar_index + 5, entry_price,        color=color.new(#2196F3, 20), width=2, style=line.style_solid)
    line.new(bar_index - 20, initial_stop, bar_index + 5, initial_stop,      color=color.new(#FF1744, 20), width=2, style=line.style_dashed)
    line.new(bar_index - 10, breakeven_trigger, bar_index + 5, breakeven_trigger, color=color.new(#4CAF50, 40), width=1, style=line.style_dotted)
    line.new(bar_index - 10, trail_start, bar_index + 5, trail_start,        color=color.new(#4CAF50, 40), width=1, style=line.style_dotted)
    line.new(bar_index - 10, wide_trail_start, bar_index + 5, wide_trail_start, color=color.new(#4CAF50, 40), width=1, style=line.style_dotted)

    entry_label = i_entry_price == 0 ? "Entry" : "Entry (custom)"
    label.new(bar_index + 6, entry_price,        entry_label, style=label.style_label_left, color=color.new(#2196F3, 80), textcolor=#FFFFFF, size=size.small)
    label.new(bar_index + 6, initial_stop,       "Stop",      style=label.style_label_left, color=color.new(#FF1744, 80), textcolor=#FFFFFF, size=size.small)
    label.new(bar_index + 6, breakeven_trigger,  "+1R BE",    style=label.style_label_left, color=color.new(#4CAF50, 80), textcolor=#FFFFFF, size=size.small)
    label.new(bar_index + 6, trail_start,        "+2R Trail", style=label.style_label_left, color=color.new(#4CAF50, 80), textcolor=#FFFFFF, size=size.small)
    label.new(bar_index + 6, wide_trail_start,   "+3R Wide",  style=label.style_label_left, color=color.new(#4CAF50, 80), textcolor=#FFFFFF, size=size.small)

// --- Signal Markers (filtered by score threshold) ---
score_ok = total_score >= i_sig_min_score

plotshape(i_sig_pullback and pullback_signal and not entry_blocked and score_ok ? low * 0.997 : na, "Pullback",  shape.triangleup, location.absolute, color.new(#00E676, 0), size=size.tiny)
plotshape(i_sig_vcp      and vcp_breakout    and not entry_blocked and score_ok ? low * 0.997 : na, "VCP",       shape.triangleup, location.absolute, color.new(#2979FF, 0), size=size.tiny)
plotshape(i_sig_vwap     and vwap_signal     and not entry_blocked and score_ok ? low * 0.997 : na, "VWAP",      shape.triangleup, location.absolute, color.new(#AB47BC, 0), size=size.tiny)
plotshape(i_sig_gap      and earnings_gap    and score_ok                       ? low * 0.997 : na, "Gap",       shape.triangleup, location.absolute, color.new(#FFD600, 0), size=size.tiny)
plotshape(i_sig_cap      and cap_entry                                          ? low * 0.997 : na, "CAP",       shape.triangleup, location.absolute, color.new(#FF6D00, 0), size=size.tiny)
plotshape(i_sig_climax   and climax_warning                                     ? high * 1.003 : na, "Climax",   shape.triangledown, location.absolute, color.new(#FF1744, 0), size=size.tiny)
plotshape(i_sig_blocked  and entry_blocked and (pullback_signal or vcp_breakout or vwap_signal) ? high * 1.003 : na, "Blocked", shape.xcross, location.absolute, color.new(#FF9800, 40), size=size.tiny)

// --- Background Tint ---
regime_bg = regime_green ? color.new(#00C853, 96) : regime_red ? color.new(#FF1744, 96) : color.new(#FFD600, 97)
bgcolor(i_show_bg_regime ? regime_bg : na, title="Regime BG")

// ═══════════════════════════════════════════════════════════════════════════════
// ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(pullback_signal and not entry_blocked and total_score >= i_min_score, "TREND: Pullback Entry", "TradeGuard GO: Pullback to 21-EMA on {{ticker}}")
alertcondition(vcp_breakout and not entry_blocked and total_score >= i_min_score, "TREND: VCP Breakout", "TradeGuard GO: VCP Breakout on {{ticker}}")
alertcondition(vwap_signal and not entry_blocked and total_score >= i_min_score, "TREND: VWAP Retest", "TradeGuard GO: VWAP Retest on {{ticker}}")
alertcondition(cap_entry, "CAPITULATION Entry", "TradeGuard CAP: RSI(2) < 5 on {{ticker}}, VIX > 30")
alertcondition(climax_warning, "Climax Warning", "TradeGuard: Climax signals on {{ticker}}")
alertcondition(regime_changed_to_red, "Regime -> RED", "TradeGuard REGIME: RED - halt TREND entries")
alertcondition(regime_changed_to_green, "Regime -> GREEN", "TradeGuard REGIME: GREEN - full operations")
alertcondition(extended_21ema, "Extended > 10% above 21-EMA", "TradeGuard: {{ticker}} extended - NO BUY")
alertcondition(entry_blocked, "Entry Blocked", "TradeGuard: Anti-chase filter active on {{ticker}}")
alertcondition(vcp_setup and not vcp_breakout, "VCP Setup Detected", "TradeGuard: VCP forming on {{ticker}}")
alertcondition(earnings_gap, "Post-Earnings Gap", "TradeGuard: Gap-up on volume on {{ticker}}")
alertcondition(template_score == 8 and template_score[1] < 8, "Template 8/8", "TradeGuard: {{ticker}} now 8/8 Minervini")
alertcondition(template_score < i_min_template and template_score[1] >= i_min_template, "Template Dropped", "TradeGuard: {{ticker}} template below threshold")
