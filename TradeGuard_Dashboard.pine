// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © TradeGuard v7.0 — Dashboard Panel
// Single wide table at the bottom: Regime, Template, Scorecard, Trade Plan
// Black and grey styling, full-width rows

//@version=6
indicator("TradeGuard Dashboard", overlay=false, precision=2)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

grp_acct = "Account Settings"
i_account_nav    = input.float(450000, "Account NAV ($)",          group=grp_acct, minval=1000)
i_risk_trend_pct = input.float(1.0,    "Risk per TREND trade (%)", group=grp_acct, minval=0.1, maxval=5.0, step=0.1)
i_risk_cap_pct   = input.float(0.5,    "Risk per CAP trade (%)",   group=grp_acct, minval=0.1, maxval=2.0, step=0.1)
i_max_pos_pct    = input.float(20.0,   "Max position (% NAV)",     group=grp_acct, minval=1.0, maxval=50.0, step=0.5)

grp_entry = "Entry Settings"
i_entry_price  = input.float(0,      "Custom Entry Price (0 = use close)", group=grp_entry, minval=0, tooltip="Set a specific entry price. Leave 0 to use current close.")
i_sector_etf   = input.symbol("XLK", "Sector ETF for RS",                  group=grp_entry)
i_min_template = input.int(7,        "Min Template Score",                  group=grp_entry, minval=1, maxval=8)
i_min_score    = input.int(9,        "Min Go/No-Go Score",                  group=grp_entry, minval=1, maxval=12)

grp_stop = "Stop Settings"
i_max_stop_pct   = input.float(8.0, "Max Stop Distance (%)",        group=grp_stop, minval=1.0, maxval=20.0, step=0.5)
i_atr_low_mult   = input.float(2.0, "ATR Low-Vol Multiplier",       group=grp_stop, minval=1.0, maxval=5.0, step=0.25)
i_atr_high_mult  = input.float(2.5, "ATR High-Vol Multiplier",      group=grp_stop, minval=1.0, maxval=5.0, step=0.25)
i_atr_vol_thresh = input.float(4.0, "ATR Volatility Threshold (%)", group=grp_stop, minval=1.0, maxval=10.0, step=0.5)

// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

sma50  = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)
ema21  = ta.ema(close, 21)
sma5   = ta.sma(close, 5)

[st_line_d, st_dir_d] = ta.supertrend(3.0, 14)
st_bull_d = st_dir_d < 0
[st_line_w, st_dir_w] = request.security(syminfo.tickerid, "W", ta.supertrend(3.0, 10))
st_bull_w = st_dir_w < 0

[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
rsi2      = ta.rsi(close, 2)
atr_val   = ta.atr(14)
atr_pct   = atr_val / close * 100
vol_sma50 = ta.sma(volume, 50)
vol_ratio = volume / vol_sma50
vol_breakout  = vol_ratio >= 1.4
vol_declining = ta.sma(volume, 10) < vol_sma50 * 0.8
vwap_val      = ta.vwap

// --- Regime ---
spy_close  = request.security("SPY", "D", close)
spy_sma200 = request.security("SPY", "D", ta.sma(close, 200))
vix_close  = request.security("CBOE:VIX", "D", close)
vix3m_close = request.security("CBOE:VIX3M", "D", close)
breadth    = request.security("INDEX:S5TH", "D", close)
hy_oas     = request.security("FRED:BAMLH0A0HYM2", "D", close)

spy_above_200  = spy_close > spy_sma200
vix_low        = vix_close < 20
vix_mid        = vix_close >= 20 and vix_close <= 30
vix_high       = vix_close > 30
breadth_strong = breadth > 50
breadth_weak   = breadth < 30
hy_safe        = na(hy_oas) ? true : hy_oas < 5
hy_danger      = na(hy_oas) ? false : hy_oas > 6
vix_contango   = na(vix3m_close) ? true : vix_close < vix3m_close

regime_green  = spy_above_200 and vix_low and breadth_strong and hy_safe
regime_red    = vix_high or hy_danger or breadth_weak
regime_str    = regime_green ? "GREEN" : regime_red ? "RED" : "YELLOW"
regime_color  = regime_green ? color.new(#4CAF50,0) : regime_red ? color.new(#EF5350,0) : color.new(#FFC107,0)

// --- Template ---
low_52w  = ta.lowest(low, 252)
high_52w = ta.highest(high, 252)
spy_close_d  = spy_close
stock_6m_ret = (close - close[126]) / close[126] * 100
spy_6m_ret   = (spy_close_d - spy_close_d[126]) / spy_close_d[126] * 100
rs_score     = math.max(0, math.min(99, math.round(50 + (stock_6m_ret - spy_6m_ret) * 1.65)))

t1 = close > sma150 and close > sma200
t2 = sma150 > sma200
t3 = sma200 > nz(sma200[100])
t4 = sma50 > sma150 and sma50 > sma200
t5 = close > sma50
t6 = close >= 1.25 * low_52w
t7 = close >= 0.75 * high_52w
t8 = rs_score >= 70
template_score = (t1?1:0)+(t2?1:0)+(t3?1:0)+(t4?1:0)+(t5?1:0)+(t6?1:0)+(t7?1:0)+(t8?1:0)

// --- Sector RS ---
sector_close    = request.security(i_sector_etf, "D", close)
sector_2w_ret   = (sector_close - sector_close[10]) / sector_close[10] * 100
spy_2w_ret      = (spy_close_d - spy_close_d[10]) / spy_close_d[10] * 100
sector_rs_st    = sector_2w_ret - spy_2w_ret
sector_3m_ret   = (sector_close - sector_close[63]) / sector_close[63] * 100
spy_3m_ret      = (spy_close_d - spy_close_d[63]) / spy_close_d[63] * 100
sector_rs_score = math.max(0, math.min(100, math.round(50 + (sector_3m_ret - spy_3m_ret) * 5)))
sector_strong   = sector_rs_score > 75

// --- Entry signals ---
pullback_signal = low <= ema21 and close > ema21 and close > open and close > (high+low)/2 and template_score >= i_min_template
range_current = ta.highest(high, 10) - ta.lowest(low, 10)
range_prior   = ta.highest(high[10], 20) - ta.lowest(low[10], 20)
vcp_setup     = range_current < range_prior * 0.6 and vol_declining and template_score >= i_min_template
pivot_high    = ta.highest(high, 10)
vcp_breakout  = ta.crossover(close, pivot_high[1]) and vol_breakout
vwap_touch    = low <= vwap_val * 1.005 and low >= vwap_val * 0.995
vwap_signal   = vwap_touch and close > vwap_val and close > open and template_score >= i_min_template
earnings_gap  = open > close[1] * 1.03 and volume > vol_sma50 * 2.0
cap_entry     = rsi2 < 5 and close > sma200 and vix_close > 30 and template_score >= 6 and close > open and close > (high+low)/2

extended_21ema = close > ema21 * 1.10
extended_50sma = close > sma50 * 1.15

// --- Scoring ---
entry_price  = i_entry_price == 0 ? close : i_entry_price
stop_mult    = atr_pct <= i_atr_vol_thresh ? i_atr_low_mult : i_atr_high_mult
raw_stop     = entry_price - (stop_mult * atr_val)
max_stop     = entry_price * (1 - i_max_stop_pct / 100)
initial_stop = math.max(raw_stop, max_stop)
r_value      = entry_price - initial_stop
stop_pct     = entry_price > 0 ? (entry_price - initial_stop) / entry_price * 100 : 0
rr_ratio     = r_value > 0 ? (high_52w - entry_price) / r_value : 0

has_pattern   = pullback_signal or vcp_setup or vwap_signal or earnings_gap
pts_regime    = regime_green ? 2 : (not regime_red ? 1 : 0)
pts_trend     = (st_bull_d?1:0) + (st_bull_w?1:0)
pts_sector    = sector_strong ? 1 : 0
pts_setup     = (template_score >= 8 ? 1 : 0) + (has_pattern ? 1 : 0)
pts_catalyst  = earnings_gap ? 1 : 0
pts_rr        = rr_ratio >= 5 ? 2 : rr_ratio >= 3 ? 1 : 0
pts_extension = (not extended_21ema and not extended_50sma) ? 1 : 0
pts_portfolio = adx_val > 25 ? 1 : 0
total_score   = pts_regime + pts_trend + pts_sector + pts_setup + pts_catalyst + pts_rr + pts_extension + pts_portfolio

verdict_go   = total_score >= i_min_score
verdict_str  = verdict_go ? "GO" : total_score >= 6 ? "WATCHLIST" : "NO TRADE"
verdict_color = verdict_go ? color.new(#4CAF50,0) : total_score >= 6 ? color.new(#FFC107,0) : color.new(#EF5350,0)

// Conviction
tier_a_plus = template_score == 8 and st_bull_w and st_bull_d and adx_val > 25 and sector_strong
tier_a      = template_score == 8 and st_bull_d and (vcp_breakout or pullback_signal) and sector_rs_score > 50
tier_b      = template_score >= 7 and st_bull_d
conviction  = tier_a_plus ? "A+" : tier_a ? "A" : tier_b ? "B" : "-"

// --- Position sizing (NAV-capped) ---
risk_dollars      = i_account_nav * (i_risk_trend_pct / 100)
shares_probe_raw  = r_value > 0 ? math.floor(risk_dollars / r_value) : 0
shares_target_raw = math.floor(shares_probe_raw / 0.5)
max_shares_nav    = entry_price > 0 ? math.floor((i_account_nav * i_max_pos_pct / 100) / entry_price) : 0
is_nav_capped     = shares_target_raw > max_shares_nav
shares_target     = math.min(shares_target_raw, max_shares_nav)
shares_probe      = math.floor(shares_target * 0.5)
shares_confirm    = math.floor(shares_target * 0.30)
shares_load       = shares_target - shares_probe - shares_confirm

confirm_price  = entry_price * 1.025
load_price     = entry_price * 1.05
probe_value    = shares_probe * entry_price
probe_pct_nav  = i_account_nav > 0 ? probe_value / i_account_nav * 100 : 0
full_value     = shares_target * entry_price
full_pct_nav   = i_account_nav > 0 ? full_value / i_account_nav * 100 : 0
probe_risk     = shares_probe * r_value
probe_risk_pct = i_account_nav > 0 ? probe_risk / i_account_nav * 100 : 0
full_risk      = shares_target * r_value
full_risk_pct  = i_account_nav > 0 ? full_risk / i_account_nav * 100 : 0

breakeven_trigger = entry_price + r_value
trail_start       = entry_price + (2 * r_value)
wide_trail_start  = entry_price + (3 * r_value)

entry_type_str = pullback_signal ? "Pullback" : vcp_breakout ? "VCP" : vwap_signal ? "VWAP" : earnings_gap ? "Gap" : cap_entry ? "CAP" : "Manual"

// ═══════════════════════════════════════════════════════════════════════════════
// KEEP PANE MINIMAL — no visible plots
// ═══════════════════════════════════════════════════════════════════════════════
plot(na)

// ═══════════════════════════════════════════════════════════════════════════════
// PALETTE — black and grey
// ═══════════════════════════════════════════════════════════════════════════════

c_black   = color.new(#0A0A0A, 0)
c_header  = color.new(#161616, 0)
c_label   = color.new(#606060, 0)
c_val     = color.new(#C0C0C0, 0)
c_white   = color.new(#E8E8E8, 0)
c_pass    = color.new(#5C8A5C, 0)   // muted green
c_fail    = color.new(#8A5C5C, 0)   // muted red
c_border  = color.new(#1E1E1E, 0)

// ═══════════════════════════════════════════════════════════════════════════════
// PADDING HELPERS — defined at script level (Pine v6 allows typed params here)
// Pine tables auto-size to content; padding forces cells wider/taller
// ═══════════════════════════════════════════════════════════════════════════════

_pad = "  "  // 2-space horizontal pad

_h(string txt) =>
    _pad + txt + _pad

_d(string txt) =>
    _pad + txt + _pad

// ═══════════════════════════════════════════════════════════════════════════════
// FULL-WIDTH TABLE — compact sizing to fit strategy pane
// ═══════════════════════════════════════════════════════════════════════════════

// Column width distribution (10 columns summing to 100%)
var float W = 10.0  // each column = 10% of pane width

if barstate.islast
    var table d = table.new(position.top_left, 10, 13, bgcolor=c_black, border_width=1, border_color=c_border, frame_width=0, frame_color=c_border)

    // ─── ROW 0: REGIME HEADER ───────────────────────────────────────────────
    table.cell(d, 0, 0, _h("REGIME"), text_color=c_white, bgcolor=c_header, text_size=size.large, text_halign=text.align_left, width=W)
    table.cell(d, 1, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 2, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 3, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 4, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 5, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 6, 0, "", bgcolor=c_header, width=W)
    table.cell(d, 7, 0, "", bgcolor=c_header, width=W)
    table.merge_cells(d, 0, 0, 7, 0)
    table.cell(d, 8, 0, _h(regime_str), text_color=regime_color, bgcolor=c_header, text_size=size.large, text_halign=text.align_right, width=W)
    table.cell(d, 9, 0, "", bgcolor=c_header, width=W)
    table.merge_cells(d, 8, 0, 9, 0)

    // ─── ROW 1: REGIME DATA ─────────────────────────────────────────────────
    spy_lbl = "SPY " + str.tostring(spy_close, "#.##")
    spy_c   = spy_above_200 ? c_pass : c_fail
    table.cell(d, 0, 1, _d(spy_lbl),                                                              text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 1, 1, _d(spy_above_200 ? "Above 200" : "Below 200"),                            text_color=spy_c,   bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    vix_c = vix_low ? c_pass : vix_mid ? c_val : c_fail
    table.cell(d, 2, 1, _d("VIX " + str.tostring(vix_close, "#.#")),                              text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 3, 1, _d(vix_low ? "Low" : vix_mid ? "Elevated" : "High"),                      text_color=vix_c,   bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    vts_c = vix_contango ? c_pass : c_fail
    table.cell(d, 4, 1, _d("Term"),                                                                text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 5, 1, _d(vix_contango ? "Contango" : "Backwardation"),                           text_color=vts_c,   bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    b_c = breadth_strong ? c_pass : breadth_weak ? c_fail : c_val
    table.cell(d, 6, 1, _d("Breadth " + str.tostring(breadth, "#.#") + "%"),                       text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 7, 1, _d(breadth_strong ? "Strong" : breadth_weak ? "Weak" : "Mixed"),           text_color=b_c,     bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    hy_c = hy_safe ? c_pass : hy_danger ? c_fail : c_val
    table.cell(d, 8, 1, _d("HY " + (na(hy_oas) ? "N/A" : str.tostring(hy_oas, "#.##") + "%")),   text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 9, 1, _d(hy_safe ? "Safe" : hy_danger ? "Danger" : "Watch"),                    text_color=hy_c,    bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    // ─── ROW 2: TEMPLATE HEADER ─────────────────────────────────────────────
    table.cell(d, 0, 2, _h("TREND TEMPLATE"), text_color=c_white, bgcolor=c_header, text_size=size.large, text_halign=text.align_left, width=W)
    table.merge_cells(d, 0, 2, 7, 2)
    sc_t = template_score == 8 ? c_pass : template_score >= 6 ? c_val : c_fail
    table.cell(d, 8, 2, _h(str.tostring(template_score) + " / 8"), text_color=sc_t, bgcolor=c_header, text_size=size.large, text_halign=text.align_right, width=W)
    table.merge_cells(d, 8, 2, 9, 2)

    // ─── ROW 3: TEMPLATE CRITERIA ───────────────────────────────────────────
    t_pass = array.from(t1, t2, t3, t4, t5, t6, t7, t8)
    t_nums = array.from("1: P>150&200", "2: 150>200", "3: 200 rising", "4: 50>150&200", "5: P>50", "6: >25% 52wL", "7: <25% 52wH", "8: RS>=70")
    for i = 0 to 7
        p = array.get(t_pass, i)
        table.cell(d, i, 3, _d(array.get(t_nums, i)), text_color=p ? c_pass : c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_center, width=W)
    table.cell(d, 8, 3, _d("RS: " + str.tostring(rs_score)), text_color=rs_score >= 70 ? c_pass : c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_center, width=W)
    table.merge_cells(d, 8, 3, 9, 3)

    // ─── ROW 4: SCORECARD HEADER ────────────────────────────────────────────
    table.cell(d, 0, 4, _h("GO / NO-GO"), text_color=c_white, bgcolor=c_header, text_size=size.large, text_halign=text.align_left, width=W)
    table.merge_cells(d, 0, 4, 7, 4)
    sc_s = total_score >= i_min_score ? c_pass : total_score >= 6 ? c_val : c_fail
    table.cell(d, 8, 4, _h(str.tostring(total_score) + " / 12"), text_color=sc_s, bgcolor=c_header, text_size=size.large, text_halign=text.align_right, width=W)
    table.merge_cells(d, 8, 4, 9, 4)

    // ─── ROW 5: SCORECARD DATA ──────────────────────────────────────────────
    s_names = array.from("Regime", "Trend", "Sector", "Setup", "Catalyst", "R:R", "Extension", "Fit")
    s_pts   = array.from(pts_regime, pts_trend, pts_sector, pts_setup, pts_catalyst, pts_rr, pts_extension, pts_portfolio)
    s_max   = array.from(2, 2, 1, 2, 1, 2, 1, 1)
    for i = 0 to 7
        p = array.get(s_pts, i)
        m = array.get(s_max, i)
        pc = p == m ? c_pass : p > 0 ? c_val : c_fail
        table.cell(d, i, 5, _d(array.get(s_names, i) + " " + str.tostring(p) + "/" + str.tostring(m)), text_color=pc, bgcolor=c_black, text_size=size.normal, text_halign=text.align_center, width=W)
    table.cell(d, 8, 5, _d(verdict_str), text_color=verdict_color, bgcolor=c_black, text_size=size.normal, text_halign=text.align_center, width=W)
    table.cell(d, 9, 5, _d("Tier " + conviction), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_center, width=W)

    // ─── ROW 6: TRADE PLAN HEADER ───────────────────────────────────────────
    entry_lbl = i_entry_price == 0 ? syminfo.ticker : syminfo.ticker + "  (custom $" + str.tostring(i_entry_price, "#.##") + ")"
    table.cell(d, 0, 6, _h("TRADE PLAN  " + entry_lbl), text_color=c_white, bgcolor=c_header, text_size=size.large, text_halign=text.align_left, width=W)
    table.merge_cells(d, 0, 6, 7, 6)
    mode_str = cap_entry ? "CAP" : "TREND"
    table.cell(d, 8, 6, _h(mode_str + " | " + entry_type_str), text_color=c_val, bgcolor=c_header, text_size=size.large, text_halign=text.align_right, width=W)
    table.merge_cells(d, 8, 6, 9, 6)

    // ─── ROW 7: ENTRY / STOP / RISK ────────────────────────────────────────
    table.cell(d, 0, 7, _d("Entry"),       text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 1, 7, _d("$" + str.tostring(entry_price, "#.##")), text_color=c_white, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 2, 7, _d("Stop"),        text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 3, 7, _d("$" + str.tostring(initial_stop, "#.##") + " (" + str.tostring(stop_pct, "#.#") + "%)"), text_color=c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 4, 7, _d("R/Share"),     text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 5, 7, _d("$" + str.tostring(r_value, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 6, 7, _d("R:R"),         text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    rr_c = rr_ratio >= 5 ? c_pass : rr_ratio >= 3 ? c_val : c_fail
    table.cell(d, 7, 7, _d(str.tostring(rr_ratio, "#.#") + " : 1"), text_color=rr_c, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 8, 7, _d("ATR"),         text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 9, 7, _d(str.tostring(stop_mult, "#.#") + "x " + str.tostring(atr_val, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    // ─── ROW 8: POSITION SIZING ─────────────────────────────────────────────
    cap_note = is_nav_capped ? " [capped]" : ""
    table.cell(d, 0, 8, _d("Probe 50%"),   text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 1, 8, _d(str.tostring(shares_probe) + " shs  $" + str.tostring(probe_value, "#,###")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 2, 8, _d("Confirm 30%"), text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 3, 8, _d(str.tostring(shares_confirm) + " shs @ $" + str.tostring(confirm_price, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 4, 8, _d("Load 20%"),    text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 5, 8, _d(str.tostring(shares_load) + " shs @ $" + str.tostring(load_price, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 6, 8, _d("Full"),        text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 7, 8, _d(str.tostring(shares_target) + " shs  $" + str.tostring(full_value, "#,###")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 8, 8, _d(str.tostring(full_pct_nav, "#.#") + "% NAV"), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 9, 8, _d(cap_note),      text_color=c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    // ─── ROW 9: RISK ────────────────────────────────────────────────────────
    table.cell(d, 0, 9, _d("Risk Probe"),  text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 1, 9, _d("$" + str.tostring(probe_risk, "#,###") + " (" + str.tostring(probe_risk_pct, "#.#") + "% NAV)"), text_color=c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 2, 9, _d("Risk Full"),   text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 3, 9, _d("$" + str.tostring(full_risk, "#,###") + " (" + str.tostring(full_risk_pct, "#.#") + "% NAV)"), text_color=c_fail, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 4, 9, _d("ADX"),         text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 5, 9, _d(str.tostring(adx_val, "#.#")), text_color=adx_val > 25 ? c_pass : c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 6, 9, _d("Vol Ratio"),   text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 7, 9, _d(str.tostring(vol_ratio, "#.##") + "x"), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 8, 9, _d("RSI(2)"),      text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 9, 9, _d(str.tostring(rsi2, "#.#")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)

    // ─── ROW 10: EXITS HEADER ───────────────────────────────────────────────
    table.cell(d, 0, 10, _h("EXITS"), text_color=c_white, bgcolor=c_header, text_size=size.large, text_halign=text.align_left, width=W)
    table.merge_cells(d, 0, 10, 9, 10)

    // ─── ROW 11: R-STAGE LEVELS ─────────────────────────────────────────────
    table.cell(d, 0, 11, _d("+1R Breakeven"), text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 1, 11, _d("$" + str.tostring(breakeven_trigger, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 2, 11, _d("+2R Trail 15%"), text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 3, 11, _d("$" + str.tostring(trail_start, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 4, 11, _d("+3R Wide 20%"),  text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 5, 11, _d("$" + str.tostring(wide_trail_start, "#.##")), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 6, 11, _d("Time Stop"),     text_color=c_label, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 7, 11, _d("10 bars < +1R"), text_color=c_val, bgcolor=c_black, text_size=size.normal, text_halign=text.align_left, width=W)
    table.cell(d, 8, 11, _d(""),              text_color=c_label, bgcolor=c_black, text_size=size.normal, width=W)
    table.cell(d, 9, 11, _d(""),              text_color=c_label, bgcolor=c_black, text_size=size.normal, width=W)

    // ─── ROW 12: VERDICT BAR ────────────────────────────────────────────────
    v_txt = verdict_str + "  |  Score: " + str.tostring(total_score) + "/12  |  Tier: " + conviction + "  |  Template: " + str.tostring(template_score) + "/8  |  Regime: " + regime_str
    table.cell(d, 0, 12, _pad + v_txt + _pad, text_color=c_white, bgcolor=verdict_color, text_size=size.large, text_halign=text.align_center, width=W)
    table.merge_cells(d, 0, 12, 9, 12)
